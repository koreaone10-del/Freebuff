# نموذج متغيّرات البيئة — انسخه إلى ‎.env‎ أو ‎.dev.vars‎ (كلاهما مستثنى من Git)
# ولا تضع أي مفتاح حقيقي داخل ملف متعقَّب.
#
# مفتاح Respan السري (من جانب الخادم). اتركه فارغاً لتعطيل بوابة Respan
# وبقاء التوزيع المجاني كما هو.
RESPAN_API_KEY=
# اختياري: معرّف النموذج على البوابة (مثال: gpt-5.5 أو claude-sonnet-4-5-20250929)
RESPAN_MODEL=
